<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.market.mapper.ProductImageMapper">

    <select id="selectUrlsByProductId" resultType="string">
        SELECT url
        FROM product_images
        WHERE product_id = #{productId}
        ORDER BY sort_order ASC, id ASC
    </select>

    <insert id="batchInsert">
        INSERT INTO product_images (product_id, url, sort_order)
        VALUES
        <foreach collection="urls" item="url" index="index" separator=",">
            (#{productId}, #{url}, #{index})
        </foreach>
    </insert>

    <delete id="deleteByProductId">
        DELETE FROM product_images WHERE product_id = #{productId}
    </delete>
</mapper>
